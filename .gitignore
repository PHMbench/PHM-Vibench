# =====================================================================
# PHM-Vibench .gitignore  (cleaned 2026-07-05)
# Principles:
#   - Track source, configs, canonical governance (.specify/), maintained
#     tests, and the dev/ subdirs that app/ + paper workflows depend on.
#   - Ignore tool scratch, local KB vault, large/regenerable data, run
#     artifacts, and machine-local overrides.
# =====================================================================

# --- Python: bytecode / packaging ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/
.tmp/

# --- Test / coverage caches ---
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# --- IDE / editor (local) ---
.vscode/
.idea/
*.swp

# --- Jupyter checkpoints ---
.ipynb_checkpoints/

# --- Tool scratch (agent / codex / speckit working dirs, not canonical) ---
.claude/
.codex/
.agents/
.github/

# --- Local knowledge base / planning vault (kept on disk only) ---
obsidian/

# --- .specify/: track canonical governance; ignore speckit tool scaffolding ---
.specify/extensions*
.specify/init-options.json
.specify/integration.json
.specify/integrations/
.specify/scripts/
.specify/templates/
.specify/workflows/

# Goals/planning markdown: local-only (canonical copy kept elsewhere; override cleanup keep)
.specify/goals/

# --- specs/: local-only spec-kit workspace (snapshot kept in obsidian/history/) ---
specs/

# --- dev/: keep only the maintained subdirs; ignore everything else ---
/dev/*
!/dev/README.md
!/dev/main_test.py
!/dev/refactored_configs/
!/dev/refactored_configs/**
!/dev/script/
!/dev/script/**

# --- Legacy top-level plot/ removed; plotting lives in src/plot_factory/ now ---
plot/

# --- Local run artifacts / outputs ---
results/
save/
wandb/
logs/
*.log
metrics_reports/

# --- Model checkpoints / weights ---
*.pth
*.pt
*.ckpt
models/

# --- Large data files (kept on disk, not in git) ---
*.xlsx
*.h5
*.npy
data/Reference/
data/.msc
data/metadata_dummy.h5
data/metadata_5_data.h5
data/*.ipynb

# --- Generated config atlas (regenerable via scripts/gen_config_atlas) ---
docs/CONFIG_ATLAS.md

# --- Machine-local config overrides ---
configs/local/*.yaml
configs/local/*.yml

# --- Personal / scratch paths ---
LQ1/
LQ_fix/
ignore/
test.yaml
out.csv
main_LQ.py

# --- Old paper-only config paths (legacy) ---
script/LQ1/Pretraining/Pretraining_C+P.yaml
configs/template/Pretraining_C+P_patchtst.yaml
configs/test/
configs/LQ_paper/
cache/
script/unified_metric/existing_test_files/
script/unified_metric/test_results/
script/unified_metric/
