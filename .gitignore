# =====================================================================
# PHM-Vibench .gitignore  (cleaned 2026-07-09)
# Principles:
#   - Track source, maintained configs, canonical docs, and maintained tests.
#   - Ignore tool scratch, local agent state, caches, large/regenerable data,
#     run artifacts, and machine-local overrides.
# =====================================================================

# --- Python: bytecode / packaging ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/
.tmp/

# --- Test / coverage caches ---
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# --- IDE / editor (local) ---
.vscode/
.idea/
*.swp

# --- Jupyter checkpoints ---
.ipynb_checkpoints/

# --- Tool scratch / personal agent workspaces ---
# These are local working directories for specific tools or users. Keep them
# outside the public onboarding path so new users see the maintained workflow.
.claude/
.codex/
.agents/

# `.github/` is intentionally tracked for CI, security, issue templates, and
# other repository-wide collaboration policy.

# --- Local knowledge base / planning vault ---
obsidian/

# --- .specify/: track canonical governance; ignore speckit tool scaffolding ---
.specify/extensions*
.specify/init-options.json
.specify/integration.json
.specify/integrations/
.specify/scripts/
.specify/templates/
.specify/workflows/
.specify/goals/

# --- specs/: local-only spec-kit workspace ---
specs/

# --- dev/: keep only maintained subdirs; ignore everything else ---
/dev/*
!/dev/README.md
!/dev/main_test.py
!/dev/refactored_configs/
!/dev/refactored_configs/**
!/dev/script/
!/dev/script/**

# --- Legacy top-level plot/ removed; plotting lives in src/plot_factory/ ---
plot/

# --- Local run artifacts / outputs ---
results/
save/
wandb/
logs/
*.log
metrics_reports/

# --- Model checkpoints / weights ---
*.pth
*.pt
*.ckpt
models/

# --- Large data files (kept on disk, not in git) ---
*.xlsx
*.h5
*.npy
data/Reference/
data/.msc
data/metadata_dummy.h5
data/metadata_5_data.h5
data/*.ipynb

# --- Machine-local config overrides ---
# `docs/CONFIG_ATLAS.md` remains tracked because it is the rendered config SSOT.
configs/local/*.yaml
configs/local/*.yml

# --- Personal / scratch paths ---
LQ1/
LQ_fix/
ignore/
test.yaml
out.csv
main_LQ.py

# --- Old paper-only config paths (legacy) ---
script/LQ1/Pretraining/Pretraining_C+P.yaml
configs/template/Pretraining_C+P_patchtst.yaml
configs/test/
configs/LQ_paper/
