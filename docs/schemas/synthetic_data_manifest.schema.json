{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phm-vibench.local/docs/schemas/synthetic_data_manifest.schema.json",
  "title": "PHM Synthetic Data Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "synthetic_dataset_id",
    "created_at",
    "protocol",
    "config",
    "generator",
    "source_data",
    "normalization",
    "conditions",
    "sampling",
    "validity"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "synthetic_dataset_id": {"type": "string"},
    "created_at": {"type": "string"},
    "protocol": {"type": "object"},
    "config": {"type": "object"},
    "environment": {"type": "object"},
    "generator": {
      "type": "object",
      "required": ["model_type", "model_name", "loss_id", "checkpoint_path", "generator_run_id"]
    },
    "source_data": {
      "type": "object",
      "required": ["source_split", "forbidden_splits", "domain_map_path", "domain_map_hash"]
    },
    "normalization": {
      "type": "object",
      "required": ["method", "scope", "params_recorded"],
      "properties": {
        "method": {"type": "string"},
        "scope": {"type": "string"},
        "params_recorded": {"type": "boolean"},
        "per_channel": {"type": "array"},
        "params_artifact": {"type": "string"},
        "params_hash": {"type": "string"}
      }
    },
    "conditions": {
      "type": "object",
      "required": ["condition_keys", "condition_sampling_policy"]
    },
    "sampling": {
      "type": "object",
      "required": ["sampler_id", "num_steps", "seed", "num_samples", "shape"]
    },
    "validity": {
      "type": "object",
      "required": ["status", "allowed_status", "benchmark_valid", "leakage_checks"],
      "properties": {
        "status": {"enum": ["benchmark-valid", "exploratory", "docs-only"]},
        "benchmark_valid": {"type": "boolean"},
        "reason": {"type": "string"},
        "leakage_checks": {
          "type": "object",
          "required": ["split_guard_passed", "nearest_neighbor_check"],
          "properties": {
            "split_guard_passed": {"type": "boolean"},
            "nearest_neighbor_check": {"type": "string"}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "validity": {
            "properties": {
              "status": {"const": "benchmark-valid"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "normalization": {
            "properties": {
              "params_recorded": {"const": true}
            }
          },
          "validity": {
            "properties": {
              "benchmark_valid": {"const": true}
            }
          }
        }
      }
    }
  ]
}
