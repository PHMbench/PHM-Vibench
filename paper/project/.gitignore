# Explainable_FD_Toolkit Git忽略文件

# Python相关
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE相关
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统相关
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 数据文件（通常体积很大）
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# 模型文件
models/*.pth
models/*.pt
models/*.h5
models/*.pkl
!models/.gitkeep

# 实验结果
results/experiments/*
results/figures/*
results/tables/*
!results/.gitkeep
!results/experiments/.gitkeep
!results/figures/.gitkeep
!results/tables/.gitkeep

# 日志文件
logs/*.log
!logs/.gitkeep

# 临时文件
temp/
tmp/
*.tmp
*.temp

# 配置文件（包含敏感信息）
configs/local_config.yaml
configs/secret_config.yaml
*.env

# Jupyter Notebook检查点
.ipynb_checkpoints/

# 生成的大文件
*.pdf
*.psd
*.ai
*.eps

# LaTeX辅助文件
*.aux
*.bbl
*.blg
*.fls
*.synctex.gz
*.fdb_latexmk
*.out

# 备份文件
*.bak
*.backup
*.old

# 缓存
.cache/
.pytest_cache/

# Agent/runtime workspaces
.agent/
.claude/
.codex/
autoresearch/
outputs/

# 文档生成
docs/_build/
site/

# API密钥和敏感信息
.env
secrets.txt
api_keys.txt

# 研究数据（通常太大不适合Git）
datasets/
!datasets/.gitkeep

# 大型模型文件
*.bin
*.onnx
*.trt
*.engine
